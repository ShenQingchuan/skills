# 操作系统临时文件
.DS_Store
Thumbs.db

# 敏感信息与环境配置（保护密钥不被上传）
.env
.env.*
!.env.example

# 本机配置、私有 Profile 与后台服务运行记录
/config.json
/profiles/
/.local/

# 同步下载产物；手写技能直接放在 registry/ 的分类目录中
/registry/.synced/

# 编辑器与开发工具
.vscode/
.idea/
*.swp
*.swo

# 独立运行时与语言依赖缓存
.runtime/
node_modules/
npm-debug.log*
__pycache__/
*.py[cod]
.venv/
venv/

# 日志与临时文件
*.log
*.tmp
