{
  "version": 1,
  "$comment": "skill = 上游 skills/ 下的相对路径，可含子目录（如 productivity/grilling）；to = registry/ 下的相对目录。",
  "sources": {
    "antfu": {
      "repo": "https://github.com/antfu/skills",
      "ref": "main",
      "skillsDir": "skills"
    },
    "vuejs-ai": {
      "repo": "https://github.com/vuejs-ai/skills",
      "ref": "main",
      "skillsDir": "skills"
    },
    "mattpocock": {
      "repo": "https://github.com/mattpocock/skills",
      "ref": "main",
      "skillsDir": "skills"
    },
    "larksuite": {
      "repo": "https://github.com/larksuite/cli",
      "ref": "main",
      "skillsDir": "skills"
    },
    "vercel-labs": {
      "repo": "https://github.com/vercel-labs/agent-browser",
      "ref": "main",
      "skillsDir": "skills"
    }
  },
  "install": [
    { "skill": "vue", "from": "antfu", "to": "dev/frontend/vue" },
    { "skill": "agent-browser", "from": "vercel-labs", "to": "dev/agent-browser" },
    { "skill": "pinia", "from": "antfu", "to": "dev/frontend/pinia" },
    { "skill": "vite", "from": "antfu", "to": "dev/frontend/vite" },
    { "skill": "vitepress", "from": "antfu", "to": "dev/frontend/vitepress" },
    { "skill": "vitest", "from": "antfu", "to": "dev/frontend/vitest" },
    { "skill": "unocss", "from": "antfu", "to": "dev/frontend/unocss" },
    { "skill": "pnpm", "from": "antfu", "to": "dev/frontend/pnpm" },
    { "skill": "vue-best-practices", "from": "vuejs-ai", "to": "dev/frontend/vue-best-practices" },
    { "skill": "vue-debug-guides", "from": "vuejs-ai", "to": "dev/frontend/vue-debug-guides" },
    { "skill": "vue-pinia-best-practices", "from": "vuejs-ai", "to": "dev/frontend/vue-pinia-best-practices" },
    { "skill": "vue-router-best-practices", "from": "vuejs-ai", "to": "dev/frontend/vue-router-best-practices" },
    { "skill": "vue-testing-best-practices", "from": "vuejs-ai", "to": "dev/frontend/vue-testing-best-practices" },
    { "skill": "create-adaptable-composable", "from": "vuejs-ai", "to": "dev/frontend/create-adaptable-composable" },
    { "skill": "productivity/grilling", "from": "mattpocock", "to": "workflow/grilling" },    
    { "skill": "productivity/writing-for-agents", "from": "mattpocock", "to": "writing/writing-for-agents" },
    { "skill": "*", "from": "larksuite", "to": "office/lark" }
  ]
}
