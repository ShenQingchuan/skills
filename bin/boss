#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
boss: 个人 Agent 技能治理框架统一 CLI 工具
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

from boss_runtime import RUNTIME_COMMANDS, cmd_runtime
from boss_services import cmd_code, cmd_kanban
from skill_boss_profiles import load_profiles


# 定位仓库根目录与内部 bin 目录
BIN_DIR = Path(__file__).resolve().parent
ROOT_DIR = BIN_DIR.parent
ROUTER_SCRIPTS_DIR = ROOT_DIR / "skills-router" / "scripts"


def run_python_script(script_path: Path, args: list[str]) -> int:
    """使用当前 Python 解释器安全执行脚本（无需目标脚本具备可执行权限）"""
    if not script_path.exists():
        print(f"❌ 找不到对应脚本: {script_path}", file=sys.stderr)
        return 1
    cmd = [sys.executable, str(script_path)] + args
    res = subprocess.run(cmd)
    return res.returncode


def complete_skill_dirs(prefix: str) -> list[str]:
    """列出合并技能树中的分类目录，供 Shell 补全使用。"""
    if str(ROUTER_SCRIPTS_DIR) not in sys.path:
        sys.path.insert(0, str(ROUTER_SCRIPTS_DIR))
    from list_skills import skill_directory_completions

    try:
        return skill_directory_completions(load_profiles(ROOT_DIR), prefix)
    except ValueError:
        return []


def cmd_complete(args: list[str]) -> int:
    """为 Shell 补全脚本提供机器可读的数据。"""
    if not args or args[0] != "skill-dirs":
        return 1
    prefix = args[1] if len(args) > 1 else ""
    for path in complete_skill_dirs(prefix):
        print(path)
    return 0


def cmd_list(args: list[str]) -> int:
    """查看技能树（供 Agent 与人类查阅）"""
    list_script = ROUTER_SCRIPTS_DIR / "list_skills.py"
    return run_python_script(list_script, args)


def cmd_sync(args: list[str]) -> int:
    """依据 sources.json 一键同步第三方技能（类似 npm install）"""
    sync_script = BIN_DIR / "sync_skills.py"
    return run_python_script(sync_script, args)


def cmd_setup_runtime(args: list[str]) -> int:
    """安装部署独立沙盒运行引擎（Node/Bun/uv/Python/rg）"""
    is_windows = sys.platform.startswith("win")
    if is_windows:
        ps_script = BIN_DIR / "setup-runtime.ps1"
        if not ps_script.exists():
            print(f"❌ 找不到脚本: {ps_script}", file=sys.stderr)
            return 1
        cmd = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(ps_script)] + args
    else:
        sh_script = BIN_DIR / "setup-runtime.sh"
        if not sh_script.exists():
            print(f"❌ 找不到脚本: {sh_script}", file=sys.stderr)
            return 1
        cmd = ["bash", str(sh_script)] + args

    res = subprocess.run(cmd)
    return res.returncode


def print_help() -> None:
    help_text = """
boss - 个人 Agent 技能治理框架 CLI

用法:
  boss <命令> [选项...]

可用命令:
  kanban [stop] [项目路径] [--port 5173]
                             启动或停止项目工作区 .agents/kanban/ 下的网页看板服务（默认端口 5173）
                             启动: boss kanban [路径] [--port 5173]
                             停止: boss kanban stop [路径] [--port 5173]
                             支持传参: -p, --port (指定端口)
  code [stop] [项目路径] [--port 6063]
                             启动或停止轻量网页 VS Code 编辑器 (基于 coderaft)
                             启动并自动打开浏览器: boss code [路径] [--port 6063]
                             停止: boss code stop [--port 6063]
                             特性: 自动打开浏览器，闲置 2 小时无操作自动关闭守护
  list-skills                查看层级技能树（展示描述与绝对入口路径）
                             支持传参单独探查子分类，如: boss list-skills dev/
  sync-skills                同步默认 Profile 及 config.json 中启用的私有 Profile
                             支持传参: --check（仅检查是否有更新）
  setup-runtime              为本框架安装/检查独立沙盒运行引擎（Node/Bun/uv/Python/rg）
                             支持传参: -s, --status（查看就绪状态）
  bun [参数...]              使用沙盒 Bun，后续参数原样透传
  uv [参数...]               使用沙盒 uv，后续参数原样透传
  python [参数...]           使用沙盒 Python，后续参数原样透传
  node [参数...]             使用沙盒 Node.js，后续参数原样透传
  npm [参数...]              使用沙盒 npm，后续参数原样透传

选项:
  -h, --help                 查看当前帮助说明
"""
    print(help_text.strip())


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print_help()
        return 0

    command = sys.argv[1]
    extra_args = sys.argv[2:]

    if command in RUNTIME_COMMANDS:
        return cmd_runtime(command, extra_args)

    dispatch_map = {
        "kanban": cmd_kanban,
        "code": cmd_code,
        "list-skills": cmd_list,
        "sync-skills": cmd_sync,
        "setup-runtime": cmd_setup_runtime,
        "_complete": cmd_complete,
    }

    handler = dispatch_map.get(command)
    if not handler:
        print(f"❌ 未知命令: {command}\n", file=sys.stderr)
        print_help()
        return 1

    return handler(extra_args)


if __name__ == "__main__":
    sys.exit(main())
